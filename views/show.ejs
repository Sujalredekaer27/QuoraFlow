<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Post</h2>
    <p><b>id post - </b><%=post.id%></p>
    <div class="post">
        <h2 class="user"> @<%= post.username %></h2>
        <p class="content">
            <%= post.content %>
        </p>
        <a href="">edit the post</a>
        <button class="delete-post btn">Delete Post</button>
    </div>
</body>
</html>